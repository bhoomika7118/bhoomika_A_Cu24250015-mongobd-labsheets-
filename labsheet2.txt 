MATCH (s:Student {name: "Amit Sharma"})-[:ENROLLED_IN]->(c:Course)
RETURN c.name

// 5. Add and remove a relationship
MATCH (s:Student {id: 101}), (c:Course {name: "BBA"})
CREATE (s)-[:ENROLLED_IN]->(c)

MATCH (s:Student {id: 101})-[r:ENROLLED_IN]->(c:Course {name: "BBA"})
DELETE r
