9. Update department of a specific student (updateOne)
db.Students.updateOne(
  { rollNo: 104 },
  { $set: { department: "CSE" } }
)
Output:
{ "acknowledged" : true, "matchedCount" : 1, "modifiedCount" : 1 }
10. Modify semester of all students of a particular department (updateMany)
db.Students.updateMany(
  { department: "CSE" },
  { $set: { semester: 4 } }
)
Output:
{ "acknowledged" : true, "matchedCount" : 3, "modifiedCount" : 3 }
11. Replace an existing student document (replaceOne)
db.Students.replaceOne(
  { rollNo: 102 },
  {
    rollNo: 102,
    name: "Robert Johnson",
    department: "ECE",
    semester: 5,
    cgpa: 8.1
  }
)
Output:
{ "acknowledged" : true, "matchedCount" : 1, "modifiedCount" : 1 }
12. Add a new field Email to all documents
db.Students.updateMany(
  {},
  { $set: { email: "student@example.com" } }
)
Output:
{ "acknowledged" : true, "matchedCount" : 4, "modifiedCount" : 4 }
13. Remove an existing field from all documents
db.Students.updateMany(
  {},
  { $unset: { email: "" } }
)
Output:
{ "acknowledged" : true, "matchedCount" : 4, "modifiedCount" : 4 }
14. Delete a specific student by Roll Number (deleteOne)
db.Students.deleteOne({ rollNo: 104 })
Output:
{ "acknowledged" : true, "deletedCount" : 1 }
15. Delete multiple student records (deleteMany)
db.Students.deleteMany({ department: "ECE" })
Output:
{ "acknowledged" : true, "deletedCount" : 1 }
