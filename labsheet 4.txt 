1. Install & configure Apache HBase + Student table
Installation (Ubuntu/Debian example):
# Prerequisites
sudo apt update
sudo apt install openjdk-11-jdk -y
# Download & extract HBase
wget https://downloads.apache.org/hbase/2.5.8/hbase-2.5.8-bin.tar.gz
tar -xzf hbase-2.5.8-bin.tar.gz
cd hbase-2.5.8

# Configure conf/hbase-site.xml (minimal standalone)
cat > conf/hbase-site.xml <<EOF
<configuration>
  <property>
    <name>hbase.rootdir</name>
    <value>file:///tmp/hbase</value>
  </property>
  <property>
    <name>hbase.zookeeper.property.dataDir</name>
    <value>/tmp/zookeeper</value>
  </property>
</configuration>
EOF

# Start HBase
bin/start-hbase.sh
bin/hbase shell
